# Copy to .env and fill in (never commit .env)
GITHUB_TOKEN=ghp_xxx
GROQ_API_KEY=gsk_xxx
GOOGLE_API_KEY=
# Light calls (resume parsing) — Groq default = lowest latency:
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# Heavy calls (repo evaluation, crew) — Gemini default (Groq free tier
# caps output at ~1000 tokens/min, too small for evaluations):
LLM_HEAVY_PROVIDER=google
LLM_HEAVY_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT=60
